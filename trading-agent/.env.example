# 複製為 .env 後填入(.env 已被 .gitignore 排除,絕不 commit 真實 key)
# 安全原則:key 只開「現貨交易」權限、綁 IP 白名單、永遠不開「提幣」。

# --- Binance Spot Testnet(第二階段:假錢真 API)https://testnet.binance.vision ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# --- Binance 真實帳戶(第三階段,小額開始)---
BINANCE_API_KEY=
BINANCE_SECRET=

# --- Alpaca 美股(paper 與 live 用同一組 key,由程式選 endpoint)---
ALPACA_API_KEY=
ALPACA_SECRET=

# --- 真錢模式的第二道開關:要跑 live 必須手動設為 1 ---
# TRADING_AGENT_ARM_LIVE=1
